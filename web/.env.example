# Backend origin, without a trailing slash or /api suffix.
# Leave blank to use the Vite dev proxy to http://localhost:5000.
# Koyeb example: https://splitwise-api-<org>.koyeb.app
VITE_API_URL=

# Socket.IO server origin. Leave blank to disable Socket.IO.
# Required for Cloudflare Workers (not supported); set for Koyeb/Render/Fly.
VITE_SOCKET_URL=
