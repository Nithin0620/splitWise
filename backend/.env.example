# ─── Server ───────────────────────────────────────────────────
# Koyeb sets PORT automatically; expose 8000 in the service settings.
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/splitwise
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/splitwise
# Workers: mongodb+srv:// is not supported on Cloudflare Workers. Use the
#          standard mongodb://host1,host2,host3/... connection string instead.
MONGO_URI=mongodb://localhost:27017/splitwise

# ─── JWT ──────────────────────────────────────────────────────
# Generate a strong secret: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ─── Google OAuth ─────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI must match GOOGLE_CALLBACK_URL below
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Koyeb: https://<service>.koyeb.app/api/auth/google/callback

# ─── Frontend ─────────────────────────────────────────────────
# The URL of the web app (used for CORS and OAuth redirect)
CLIENT_URL=http://localhost:5173
# Koyeb: https://<frontend-domain>

# ─── Email / Resend ───────────────────────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# "From" address — must be a verified domain in your Resend account
# During development you can use: onboarding@resend.dev (Resend sandbox)
RESEND_FROM_EMAIL=SplitWise <onboarding@resend.dev>

# ─── Invite Links ─────────────────────────────────────────────
# Base URL embedded in invite emails — frontend handles /invite/accept?token=xxx
# Defaults to CLIENT_URL if not set
INVITE_BASE_URL=http://localhost:5173
# Koyeb: https://<frontend-domain>
